# Copia este archivo a .env.local y completa los valores.
# NUNCA subas .env.local al repositorio.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable

# Clave service_role (o "secret"). SOLO servidor: se salta RLS. Nunca con prefijo NEXT_PUBLIC_,
# nunca en el navegador ni en el repositorio. En Vercel, como variable de entorno del proyecto.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# URL pública del sitio (local en desarrollo; el dominio real en producción)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (CAPTCHA del registro, login de clientes y recuperar contraseña).
# Créalo en dash.cloudflare.com → Turnstile. La clave del sitio es pública; el secreto, solo servidor.
# Claves de PRUEBA de Cloudflare (siempre aprueban): sitio 1x00000000000000000000AA,
# secreto 1x0000000000000000000000000000000AA. En producción usa claves reales: sin
# TURNSTILE_SECRET_KEY el servidor RECHAZA los registros y logins de clientes.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Clave para la huella (HMAC) del IP en los límites de envíos del formulario de contacto. SOLO servidor.
# Opcional: sin ella se usa la clave service_role. Genera una larga y al azar, p. ej. `openssl rand -hex 32`.
RATE_LIMIT_SECRET=
