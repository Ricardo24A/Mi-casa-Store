# Copia este archivo a .env.local y completa los valores.
# NUNCA subas .env.local al repositorio.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable

# Clave service_role (o "secret"). SOLO servidor: se salta RLS. Nunca con prefijo NEXT_PUBLIC_,
# nunca en el navegador ni en el repositorio. En Vercel, como variable de entorno del proyecto.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# URL pública del sitio (local en desarrollo; el dominio real en producción)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (CAPTCHA del registro, login de clientes y recuperar contraseña).
# Créalo en dash.cloudflare.com → Turnstile. La clave del sitio es pública; el secreto, solo servidor.
# Claves de PRUEBA de Cloudflare (siempre aprueban): sitio 1x00000000000000000000AA,
# secreto 1x0000000000000000000000000000000AA. En producción usa claves reales: sin
# TURNSTILE_SECRET_KEY el servidor RECHAZA los registros y logins de clientes.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Clave para la huella (HMAC) del IP en los límites de envíos del formulario de contacto. SOLO servidor.
# Opcional: sin ella se usa la clave service_role. Genera una larga y al azar, p. ej. `openssl rand -hex 32`.
RATE_LIMIT_SECRET=

# Correos transaccionales con Resend (pedido, comprobante, pago, envío; avisos al dueño).
# Los correos de Supabase Auth (confirmar correo, recuperar contraseña) NO pasan por aquí.
# Clave de Resend. SOLO servidor (nunca NEXT_PUBLIC_). Sin ella, los correos quedan en modo SIMULACIÓN:
# se registra en consola el tipo y el destinatario enmascarado, sin el contenido, y nada falla.
RESEND_API_KEY=
# Remitente, p. ej. "Mi casa Store <pedidos@tudominio.ec>". Vacío = el remitente de prueba de Resend
# (onboarding@resend.dev). Al verificar el dominio en Resend, solo cambia esta variable.
EMAIL_FROM=
# A quién avisar (comprobantes por revisar, mensajes de contacto). Vacío = el correo de contacto de Configuración.
EMAIL_OWNER_TO=
# SOLO PARA PRUEBAS: redirige TODOS los correos a esta dirección (el plan de prueba de Resend solo entrega
# al correo de tu cuenta). Debe estar VACÍA en producción: si no, los clientes no recibirían nada.
EMAIL_TEST_TO=

# Solo para `npm run test:attack` (pruebas de ataque contra un proyecto de DESARROLLO). Tres cuentas de prueba que
# creas tú (ver README, "Pruebas de ataque"): dos de CLIENTE y un administrador que nunca completa el 2FA.
# ATTACK_CUSTOMER_EMAIL=
# ATTACK_CUSTOMER_PASSWORD=
# ATTACK_CUSTOMER2_EMAIL=
# ATTACK_CUSTOMER2_PASSWORD=
# ATTACK_ADMIN_NO2FA_EMAIL=
# ATTACK_ADMIN_NO2FA_PASSWORD=
# ATTACK_OTHER_USER_ID=
# ATTACK_APP_URL=http://localhost:3101
# ATTACK_APP_STRICT_URL=http://localhost:3100
